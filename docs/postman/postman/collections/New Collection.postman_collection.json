{
  "info": {
    "name": "Seja Senai API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "admin_email",
      "value": "wuzuy@gmail.com",
      "type": "string"
    },
    {
      "key": "admin_senha",
      "value": "admin",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Listar todos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios"]
            }
          }
        },
        {
          "name": "Cadastrar novo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeCompleto\": \"Aluno Teste\",\n  \"email\": \"aluno@email.com\",\n  \"senha\": \"123\",\n  \"cpf\": \"11122233344\",\n  \"telefone\": \"2199999999\",\n  \"dataNascimento\": \"2000-01-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios"]
            }
          }
        },
        {
          "name": "Realizar Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aluno@email.com\",\n  \"senha\": \"123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/login",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "login"]
            }
          }
        },
        {
          "name": "Atualizar Permissão",
          "request": {
            "method": "PUT",
            "header": [],
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "password", "value": "{{admin_senha}}", "type": "string" },
                { "key": "username", "value": "{{admin_email}}", "type": "string" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/1/role?role=ROLE_ADMIN",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "1", "role"],
              "query": [
                { "key": "role", "value": "ROLE_ADMIN" }
              ]
            }
          }
        },
        {
          "name": "Remover",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/usuarios/1",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Unidades",
      "item": [
        {
          "name": "Listar todas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/unidades",
              "host": ["{{baseUrl}}"],
              "path": ["unidades"]
            }
          }
        },
        {
          "name": "Cadastrar unidade",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "password", "value": "{{admin_senha}}", "type": "string" },
                { "key": "username", "value": "{{admin_email}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Firjan SENAI Caxias\",\n  \"cnpj\": \"12345678000199\",\n  \"estado\": \"RJ\",\n  \"cidade\": \"Duque de Caxias\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/unidades",
              "host": ["{{baseUrl}}"],
              "path": ["unidades"]
            }
          }
        },
        {
          "name": "Remover",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/unidades/1",
              "host": ["{{baseUrl}}"],
              "path": ["unidades", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Cursos",
      "item": [
        {
          "name": "Listar todos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/cursos",
              "host": ["{{baseUrl}}"],
              "path": ["cursos"]
            }
          }
        },
        {
          "name": "Cadastrar curso",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "password", "value": "{{admin_senha}}", "type": "string" },
                { "key": "username", "value": "{{admin_email}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_unidade\": { \"id\": 1 },\n  \"nome_curso\": \"Desenvolvimento de Sistemas\",\n  \"tipo\": \"Tecnico\",\n  \"turno\": \"Noite\",\n  \"data_inicio\": \"2026-02-25\",\n  \"duracao_meses\": 18,\n  \"status\": \"Aberto\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/cursos",
              "host": ["{{baseUrl}}"],
              "path": ["cursos"]
            }
          }
        },
        {
          "name": "Remover",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/cursos/1",
              "host": ["{{baseUrl}}"],
              "path": ["cursos", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Inscricoes",
      "item": [
        {
          "name": "Listar todas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/inscricoes",
              "host": ["{{baseUrl}}"],
              "path": ["inscricoes"]
            }
          }
        },
        {
          "name": "Nova inscrição",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_usuario\": { \"id\": 1 },\n  \"id_curso\": { \"id\": 1 },\n  \"id_unidade\": \"1\",\n  \"data_inscricao\": \"2026-02-27\",\n  \"status_aprovacao\": \"Pendente\",\n  \"escolaridade_declarada\": \"Ensino Medio\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/inscricoes",
              "host": ["{{baseUrl}}"],
              "path": ["inscricoes"]
            }
          }
        },
        {
          "name": "Remover",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/inscricoes/1",
              "host": ["{{baseUrl}}"],
              "path": ["inscricoes", "1"]
            }
          }
        }
      ]
    }
  ]
}