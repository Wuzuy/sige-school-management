# ============================================
# SIGE - GitIgnore
# ============================================

# ====================
# NODE
# ====================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ====================
# ENVIRONMENT
# ====================
.env
.env.local
.env.production
.env.development
*.env
!*.env.example
cookies.txt

# ====================
# IDE
# ====================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ====================
# OS
# ====================
.DS_Store
Thumbs.db
desktop.ini
*.log

# ====================
# BUILDS
# ====================
dist/
build/
out/

# ====================
# BACKUP FILES
# ====================
*.bak
*.orig
*.tmp

# ====================
# DATA (local runtime)
# ====================
backend/data/
uploads/

# ====================
# CONFIG (local overrides)
# ====================
backend/.env.local
backend/config/local.js


